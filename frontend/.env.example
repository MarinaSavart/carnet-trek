# URL de l'API vue par le navigateur. Par défaut "/api" : le serveur de dev de Vite relaie
# /api et /uploads vers le backend (même origine → cookie de session « first-party »).
VITE_API_URL=/api
# Backend vers lequel Vite relaie les requêtes (dans Docker : http://backend:3000)
API_PROXY_TARGET=http://localhost:3000

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/carnet-trek
# Dossier où sont stockés les GPX et photos envoyés (relatif au dossier backend)
UPLOAD_DIR=uploads
# Origines du front autorisées à appeler l'API, séparées par des virgules
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_REQUEST=60
# Secret de signature des sessions, 32 caractères minimum, obligatoire en production.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Durée d'une session (jours)
SESSION_DAYS=7
# true : tout le monde peut créer un compte ; false : comptes créés via npm run create-user
ALLOW_REGISTRATION=true
